{
  "info": {
    "name": "Social API",
    "description": "Collection for the Social Go API (chi router, mounted under /v1).\n\nThe host is hardcoded to http://localhost:8080 in every request - no environment needed.\nIf your ADDR differs, use Postman's Find & Replace or edit the URL bar per request.\n\nRun the folders top-to-bottom: `Create post` saves `postID` to the collection variables, so the post/comment requests that follow work without editing anything.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "postID",
      "value": "1",
      "type": "string"
    },
    {
      "key": "userID",
      "value": "1",
      "type": "string"
    },
    {
      "key": "followedUserID",
      "value": "2",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/v1/health",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "health"
              ]
            },
            "description": "Returns status, env and version."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status is ok', () => {",
                  "    pm.expect(pm.response.json().data.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My first post\",\n  \"content\": \"Hello from Postman.\",\n  \"Tags\": [\"go\", \"chi\", \"postgres\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/v1/posts",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "posts"
              ]
            },
            "description": "title: required, max 100. content: required, max 1000. Tags is optional and is capitalised in the JSON tag. user_id is hardcoded to 1 until auth exists."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const id = pm.response.json().data.id;",
                  "if (id) {",
                  "    pm.collectionVariables.set('postID', String(id));",
                  "    console.log('saved postID =', id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create post - validation error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"content\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/v1/posts",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "posts"
              ]
            },
            "description": "Empty title/content fail the `required` validation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get post by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/v1/posts/{{postID}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "posts",
                "{{postID}}"
              ]
            },
            "description": "Returns the post with its comments attached. Note: the handler currently writes 201, not 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.test('body has the post', () => {",
                  "    const d = pm.response.json().data;",
                  "    pm.expect(d).to.have.property('id');",
                  "    pm.expect(d).to.have.property('title');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get post - not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/v1/posts/999999",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "posts",
                "999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"content\": \"Updated content from Postman.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/v1/posts/{{postID}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "posts",
                "{{postID}}"
              ]
            },
            "description": "Omitted fields fall back to the stored values. Update is optimistic-locked on `version`, so a stale read can yield 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('title was updated', () => {",
                  "    pm.expect(pm.response.json().data.title).to.eql('Updated title');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create comment on post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userID}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Nice post!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/v1/posts/{{postID}}/comment",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "posts",
                "{{postID}}",
                "comment"
              ]
            },
            "description": "The author comes from the X-User-Id header (placeholder until auth lands). content: required, max 1000."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('comment echoes back', () => {",
                  "    pm.expect(pm.response.json().data.content).to.eql('Nice post!');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create comment - missing X-User-Id",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Should be rejected\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/v1/posts/{{postID}}/comment",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "posts",
                "{{postID}}",
                "comment"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get user by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/v1/users/{{userID}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "users",
                "{{userID}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('body has the user', () => {",
                  "    const d = pm.response.json().data;",
                  "    pm.expect(d).to.have.property('id');",
                  "    pm.expect(d).to.have.property('email');",
                  "    pm.expect(d).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get user - not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/v1/users/999999",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "users",
                "999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get user feed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/v1/users/{{userID}}/feed",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "users",
                "{{userID}}",
                "feed"
              ]
            },
            "description": "Posts for {{userID}} with a comment_count per post. Note: the query filters on p.user_id = $1, so it returns the user's OWN posts, not posts from people they follow."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('data is an array', () => {",
                  "    pm.expect(pm.response.json().data).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('feed items carry post fields + comment_count', () => {",
                  "    const feed = pm.response.json().data;",
                  "    if (feed.length === 0) {",
                  "        pm.expect.fail('feed empty - create a post for this user first');",
                  "    }",
                  "    const item = feed[0];",
                  "    pm.expect(item).to.have.property('id');",
                  "    pm.expect(item).to.have.property('title');",
                  "    pm.expect(item).to.have.property('user_id');",
                  "    pm.expect(item).to.have.property('comment_count');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Follow user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/v1/users/{{followedUserID}}/follow",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "users",
                "{{followedUserID}}",
                "follow"
              ]
            },
            "description": "The handler takes both the follower and the followed from the same {{userID}} path param, so it currently self-follows. Kept as-is to match the code."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('no server error', () => pm.expect(pm.response.code).to.be.below(500));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Unfollow user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/v1/users/{{followedUserID}}/unfollow",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "users",
                "{{followedUserID}}",
                "unfollow"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('no server error', () => pm.expect(pm.response.code).to.be.below(500));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Cleanup",
      "description": "Runs last so the post created at the start survives the Posts and Comments folders.",
      "item": [
        {
          "name": "Delete post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/v1/posts/{{postID}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "posts",
                "{{postID}}"
              ]
            },
            "description": "Deletes {{postID}} — the post created by the Posts folder."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete post - not found",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/v1/posts/999999",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "v1",
                "posts",
                "999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
